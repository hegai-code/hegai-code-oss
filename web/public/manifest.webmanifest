{
  "name": "Hegai Code",
  "short_name": "Hegai",
  "description": "Пульт для сессий Claude Code и Codex на всех твоих машинах.",
  "id": "/w/",
  "start_url": "/w/sessions",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "lang": "ru",
