# /etc/cc-remote/provisioner.env — read by cc-remote-provisioner.service.
# Keep it 0600 root: the token below is a bearer credential for the hub's
# /api/provisioning/* routes (a separate class from the fleet token — it
# cannot open /ui or /agent). Value must match CC_REMOTE_PROVISIONER_TOKEN on
# the hub and be at least 32 characters:  openssl rand -hex 32

# The hub's PUBLIC https URL. On a self-hosted hub: https://<your domain> (the
# sandbox agents reach the hub through it, not through a loopback port).
CC_REMOTE_HUB_URL=https://code.acme.test
CC_REMOTE_PROVISIONER_TOKEN=

# Name this host reports in every claim; the hub routes jobs by it.
SANDBOX_HOST=stage

# Where sb-agent-update.sh keeps the current agent release (a symlink).
SANDBOX_AGENT_DIR=/opt/cc-remote-agent/current
SANDBOX_NODE=/usr/bin/node
SANDBOX_CODEX_BIN=/usr/bin/codex

# Sandbox users get uids in this range and this primary group.
SANDBOX_UID_MIN=20000
SANDBOX_UID_MAX=29999
SANDBOX_GROUP=sandbox

# Directory under the home that holds the member's projects (~/work).
SANDBOX_PROJECTS_DIR=work

# Model written to config.toml when a job carries no gateway.model.
SANDBOX_DEFAULT_MODEL=gpt-5.6-sol

# Preview names, one per slot ({n} = slot number). Internal default shown.
# SANDBOX_PREVIEW_HOST=preview-sb{n}.acme.test
# Gateway written to config.toml when a job names none. No built-in host: the
# hub normally sends its own LLM_PUBLIC_URL; without either, a job that carries
# a key fails rather than guessing where to send it.
# SANDBOX_GATEWAY_URL=https://llm.example.com/v1
