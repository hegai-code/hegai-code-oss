# /etc/cc-remote/sb-monitor.env — read by sb-monitor.sh (0600 root).
# Same shape as the other server monitor bots: a bot token and a chat id.
TG_BOT_TOKEN=
TG_CHAT_ID=

# Optional thresholds (defaults shown).
# SB_MEM_WARN_MB=1500        # MemAvailable below this on the host -> alert
# SB_DISK_WARN_GB=5          # free space on /home below this -> alert
# SB_HOME_WARN_GB=10         # one sandbox home above this -> alert
# SB_RESTARTS_WARN=3         # NRestarts above this -> alert
# SB_PROVISIONER_STALE_MIN=20  # provisioner journal older than this -> alert
