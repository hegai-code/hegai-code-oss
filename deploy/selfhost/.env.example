# Hegai Code self-hosted hub — configuration (twelve-factor: config lives in
# the environment, nothing else). Copy to .env, or run ./init.sh which does it
# and generates the secrets. .env is read by compose; keep it 0600, never commit.
#
# REQUIRED ----------------------------------------------------------------

# The name the hub is served on. An A/AAAA record must point at this server and
# ports 80 and 443 must be open: Caddy gets a Let's Encrypt certificate for it.
HEGAI_DOMAIN=code.example.com

# Fleet token: authenticates agents that predate enrollment and signs nothing
# else. At least 32 characters (the hub refuses to start otherwise).
#   openssl rand -hex 32          (./init.sh does this)
CC_REMOTE_TOKEN=

# The e-mail of the first account, the owner. With the hub up, the setup link
# for it is printed once in the hub log:  docker compose logs hub
CC_REMOTE_BOOTSTRAP_EMAIL=owner@example.com

# Одноразовый секрет подключения самого сервера (>= 32 символов; ./init.sh генерирует).
# Его использует connect-host.sh: сервер становится машиной владельца без ручного
# кода. Кто может читать .env, может подключить одну машину от имени владельца;
# после использования секрет мёртв. Пусто = выключено (подключайте через /go).
CC_REMOTE_HOST_ENROLLMENT_SECRET=

# OPTIONAL ----------------------------------------------------------------

# Product name shown in the interface (default: Hegai Code). The sidebar logo
# draws «Anomaly Code» as «anomaly.code». init.sh fills it from the domain.
#CC_REMOTE_BRAND_NAME=

# Sign-in. The owner always has a local password + authenticator. Add any of:
#
#  - Generic OIDC (Google Workspace, Keycloak, Entra ID, ...): people from the
#    allowed e-mail domains can sign in, the owner decides everything else.
#OIDC_ISSUER=https://accounts.google.com
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_ALLOWED_DOMAINS=example.com
#    Redirect URI to register at the provider: https://<HEGAI_DOMAIN>/api/auth/oidc/callback
#
#  - Google with your own OAuth client (redirect https://<HEGAI_DOMAIN>/api/auth/google/callback):
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#
#  - GitHub with your own GitHub App (user authorization; callback https://<HEGAI_DOMAIN>/api/auth/github/callback).
#    Newcomers get no e-mail from it; the owner activates them in the access screen.
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#    OFF by default. Only for a hub that hands out read access to a private repository
#    on activation: the App installed on that repository (Administration: read & write).
#GITHUB_GRANT_REPO=owner/name
#GITHUB_APP_ID=
#GITHUB_APP_PRIVATE_KEY_PATH=    # the PEM file: chmod 600, owned by the hub's user (else the hub refuses to start)
#GITHUB_APP_INSTALLATION_ID=
#
#  - Telegram with your own bot (@BotFather): secret is any 32+ character string.
#CC_REMOTE_TG_LOGIN_BOT=
#CC_REMOTE_TG_LOGIN_SECRET=

# Privacy policy / support / account deletion pages shown by the hub. The
# directory (mounted into the container, see compose.yml) holds privacy.html,
# support.html and delete-account.html. Unset: a neutral page saying the
# operator of this server is responsible - contact your administrator.
#CC_REMOTE_LEGAL_DIR=/legal

# LLM gateway. People use their own Claude / Codex accounts regardless; a
# gateway adds one endpoint for every model with a key per person, limits and
# «Расходы». Unset = off.
#
# The bundled one (Bifrost + CLIProxyAPI per subscription account):
#   sudo ./llm.sh enable      writes COMPOSE_FILE, LLM_ADMIN_USER/PASSWORD,
#                             LLM_GATEWAY_URL, LLM_PUBLIC_URL below - see README.
# Or your own Bifrost: its admin API (credentials in the URL when its
# auth_config is on, e.g. http://admin:secret@bifrost:8080) and the address
# handed to members. LLM_GATEWAY_URL without LLM_PUBLIC_URL keeps seats off.
#LLM_GATEWAY_URL=
#LLM_PUBLIC_URL=
# The key new people's keys are cloned from (routing, limits); default
# hegai:template-community, which ./llm.sh maintains.
#CC_REMOTE_LLM_COMMUNITY_TEMPLATE_KEY=
# Model / effort the generated Codex installers write (defaults: gpt-5.6-sol / medium).
#CC_REMOTE_LLM_INSTALLER_MODEL=
#CC_REMOTE_LLM_INSTALLER_EFFORT=
#
# Hub text jobs (suggestions, titles, dictation polish) - any OpenAI-compatible API:
#LLM_ENRICH_URL=
#LLM_ENRICH_KEY=
#LLM_ENRICH_MODEL=
#
# Gateway-only Codex sessions and the journal run on each AGENT machine, and
# only against the gateway that machine's owner names - never one the hub
# names. On every agent machine set CC_REMOTE_GATEWAY_URL in the agent service
# environment (https; http only on loopback). Not policy.json: sessions can write it.
# This server's own agent gets it from ./llm.sh.

# Push notifications through Telegram (alerts about the hub itself).
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# Уведомления на телефон (приложения Hegai Code из App Store / Google Play).
# У вашего hub нет ключей Apple/Google для наших приложений, поэтому по умолчанию
# он просит доставить пуш релей вендора (CC_REMOTE_PUBLIC_URL обязателен; включается
# только явным CC_REMOTE_PUSH_RELAY=on, init.sh пишет его сам, и адресом релея
# CC_REMOTE_PUSH_RELAY_URL — его выдаёт вендор, как CC_REMOTE_APP_DL). Релей проверяет,
# что вы владеете доменом: берёт https://<домен>/.well-known/hegai-push-relay
# (порт 443, публичный адрес). К HegAI
# уходит: токен устройства, идентификаторы сессии/машины/пользователя, состояние
# («ждёт ответа» / «ошибка» / «есть ответ») и время. Текста сессий, названий,
# команд и ответов агента в запросе нет. Отключить: удалить строку или off.
CC_REMOTE_PUSH_RELAY=on
#CC_REMOTE_PUSH_RELAY_URL=

# Dictation (speech to text). Unset = the microphone button is off.
#CLOUD_STT_URL=
#CLOUD_STT_KEY=
#CLOUD_STT_MODEL=

# Desktop apps (Mac/Windows). The install commands on the hub's start page
# download the signed builds from this address (the directory holding
# HegaiCode-mac.zip and HegaiCode-win-setup.exe) and point the app at this hub.
# This hub has no /dl of its own: set the address your vendor gave you.
#CC_REMOTE_APP_DL=

# PACKAGING (rarely changed) -----------------------------------------------

# Docker network the hub and Caddy share. The hub trusts Caddy's X-Real-IP from
# this range only. Change if 172.31.77.0/24 collides with something on the host.
#HEGAI_NET_SUBNET=172.31.77.0/24
# Memory limit of the hub container.
#HEGAI_HUB_MEM=2g
# Compose project name (prefix of containers and volumes).
#COMPOSE_PROJECT_NAME=hegai-code
