# Regenerated by tauri-build on every compile from tauri.conf.json and the
# plugins' ACL manifests. Committing it means a diff on every dependency bump
# for a file nobody reads.
src-tauri/gen/schemas/
# Same for the app's own command permissions (`allow-shell-*`): tauri-build
# writes them from the command list in build.rs on every compile.
src-tauri/permissions/autogenerated/
