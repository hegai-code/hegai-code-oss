{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hegai Code",
  "version": "0.1.32",
  "identifier": "net.hegai.ccremote.windows",
  "build": {
    "frontendDist": "../offline"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Hegai",
    "copyright": "Hegai",
    "category": "DeveloperTool",
    "shortDescription": "Пульт для сессий Claude Code и Codex",
    "longDescription": "Hegai Code — смотрите, ведите и возобновляйте сессии Claude Code и Codex на всех машинах команды.",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://code.acme.test/dl/updates-{{target}}.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGMEQ5QTRGRDBGOENGNkQKUldSdHovalFUNW9OditQbUVhMzRoMDUrVUYrNWhIQ1VQRDNVdFhiU1hQd1h2Y0JyRlZUTGtVblQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
