<?xml version="1.0" encoding="utf-8"?>
<!-- One family so a Markdown **bold** span resolves to Onest SemiBold instead of a synthetic bold. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:fontStyle="normal" android:fontWeight="400" android:font="@font/onest_regular" app:fontStyle="normal" app:fontWeight="400" app:font="@font/onest_regular" />
    <font android:fontStyle="normal" android:fontWeight="500" android:font="@font/onest_medium" app:fontStyle="normal" app:fontWeight="500" app:font="@font/onest_medium" />
    <font android:fontStyle="normal" android:fontWeight="600" android:font="@font/onest_semibold" app:fontStyle="normal" app:fontWeight="600" app:font="@font/onest_semibold" />
</font-family>
