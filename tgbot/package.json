{
  "name": "@cc-remote/tgbot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram client for the hub: pick a project, pick or start a session, and drive it from a phone. One more /ui client alongside web/ and ios/ — it changes no protocol.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@cc-remote/shared": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
