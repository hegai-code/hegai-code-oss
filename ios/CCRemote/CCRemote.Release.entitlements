<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Release (TestFlight / App Store) entitlements. Hand-maintained: XcodeGen only
  generates CCRemote.entitlements from project.yml, and a distribution build has
  to declare the PRODUCTION APNs environment or every push it registers for is
  minted against sandbox and silently never arrives.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array><string>Default</string></array>
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
