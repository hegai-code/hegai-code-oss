<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened-runtime resource access, not App Sandbox (which this app does
	     not adopt — see project.yml). Without this the notarized build's mic
	     button silently records nothing on employees' machines. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
